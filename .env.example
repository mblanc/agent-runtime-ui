# ==========================================
# Authentication (better-auth + Google Identity)
# ==========================================
# Generate secret using: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# Google Cloud Agent Runtime (Vertex AI)
# ==========================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Full reasoning engine resource name, e.g.:
# projects/1234567890/locations/us-central1/reasoningEngines/9876543210
GOOGLE_REASONING_ENGINE_ID=projects/YOUR_PROJECT_NUMBER/locations/us-central1/reasoningEngines/YOUR_ENGINE_ID

# Optional: Set to "true" to enable mock agent streaming for local testing without GCP credentials
MOCK_AGENT_RUNTIME=false
